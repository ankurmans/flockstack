{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	// FlockStack Cloud's lean API Worker (docs/ARCHITECTURE-WORKERS.md): the REST API, the MCP server and the OAuth endpoints an MCP
	// client calls, without Next.js. One script (scripts/build-api-worker.mjs builds it, as Wrangler's build step) deployed twice, one
	// per region, bound to the same database and buckets as that region's app Worker. Nothing reaches it from outside: the router
	// holds the domain and hands it requests through its API service binding, so no workers.dev address and no routes here.
	//
	// It needs the same secrets and variables as the app for what it serves (BETTER_AUTH_SECRET, SUPPRESSION_HASH_KEY, APP_URL,
	// UPSTASH_*, STRIPE_*, SES_*, QSTASH_*, POLAR_*, IMAGES_S3_* ...: `node scripts/api-env.mjs` lists the ones the bundle reads).
	// Secrets are per Worker: `wrangler secret put` each of them for flockstack-api and flockstack-api-eu.
	"name": "flockstack-api",
	"main": "dist/index.js",
	"no_bundle": true,
	"build": { "command": "node scripts/build-api-worker.mjs", "cwd": "../.." },
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"workers_dev": false,
	"preview_urls": false,
	"observability": { "enabled": true },
	"upload_source_maps": false,
	"account_id": "fe96ffccbfec88e9c8516169adb1fee2",
	"d1_databases": [{ "binding": "DB", "database_name": "flockstack", "database_id": "97615845-8aa2-413f-ad98-89821937069f" }],
	"r2_buckets": [
		{ "binding": "IMAGES", "bucket_name": "flockstack-images" },
		{ "binding": "FILES", "bucket_name": "flockstack-files" },
		{ "binding": "EXPORTS", "bucket_name": "flockstack-exports" }
	],
	"ai": { "binding": "AI" },
	// The region's app Worker: where an action's page revalidation goes (lib/internal-revalidate.js). Deploy the app first.
	"services": [{ "binding": "APP", "service": "flockstack" }],
	"vars": {
		"IMAGES_STORAGE": "r2",
		"FLOCKSTACK_CLOUD": "true",
		"FLOCKSTACK_REGION": "us"
	},
	"env": {
		"eu": {
			"name": "flockstack-api-eu",
			"main": "dist/index.js",
			"no_bundle": true,
			"build": { "command": "node scripts/build-api-worker.mjs", "cwd": "../.." },
			"compatibility_date": "2026-09-01",
			"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
			"workers_dev": false,
			"preview_urls": false,
			"observability": { "enabled": true },
			"upload_source_maps": false,
			"account_id": "fe96ffccbfec88e9c8516169adb1fee2",
			"d1_databases": [{ "binding": "DB", "database_name": "flockstack-eu", "database_id": "3ffda07e-c73f-46ee-a933-1eb4feb18f70" }],
			"r2_buckets": [
				{ "binding": "IMAGES", "bucket_name": "flockstack-images-eu", "jurisdiction": "eu" },
				{ "binding": "FILES", "bucket_name": "flockstack-files-eu", "jurisdiction": "eu" },
				{ "binding": "EXPORTS", "bucket_name": "flockstack-exports-eu", "jurisdiction": "eu" }
			],
			"ai": { "binding": "AI" },
			"services": [{ "binding": "APP", "service": "flockstack-eu" }],
			"vars": {
				"IMAGES_STORAGE": "r2",
				"FLOCKSTACK_CLOUD": "true",
				"FLOCKSTACK_REGION": "eu",
				"SES_REGION": "eu-west-1"
			}
		}
	}
}

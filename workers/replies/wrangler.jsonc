{
	"name": "flockstack-replies",
	"main": "index.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"services": [{ "binding": "APP", "service": "flockstack" }],
	"env": { "eu": { "name": "flockstack-replies-eu", "services": [{ "binding": "APP", "service": "flockstack-eu" }] } }
}

{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	// FlockStack Cloud's front door (docs/ARCHITECTURE-WORKERS.md). Two deployments of one script, one per region, because they bind
	// different app Workers and read different cookies; each fails alone.
	//
	// The top level and env.eu-staged have NO routes: they live on workers.dev, to be tested before a domain moves. env.us and
	// env.eu are the same Workers with the custom domain, and deploying them is the cutover: it takes flockstack.io (or
	// eu.flockstack.io) from the app Worker and gives it to this one (README, Regions, and the runbook in docs/ARCHITECTURE-WORKERS.md).
	// Each region's router binds that region's own public pages Worker (flockstack-public, flockstack-public-eu) and app.
	// The API binding is the lean API Worker (workers/api, flockstack-api and flockstack-api-eu), which a deploy needs to exist first.
	// The router sends it nothing until API_ENABLED says so: a secret of the router (`wrangler secret put API_ENABLED`, "all" or a
	// list of rest, mcp, wellknown, oauth; `wrangler secret delete API_ENABLED` is the off switch), API_ENABLED_WORKERS_DEV the same
	// for requests to a workers.dev address, so it can be tried there first. Secrets, not vars, so a deploy does not put them back.
	// The READERS binding is the lean readers Worker (workers/readers, flockstack-readers and flockstack-readers-eu): the open pixel, the
	// click redirect, unsubscribe, the archive's beacons and the signup forms' address. Same switches: READERS_ENABLED ("all" or a list
	// of tracking, unsubscribe, beacons, forms) and READERS_ENABLED_WORKERS_DEV, secrets of the router, off until set. A newsletter's own
	// host sees it only once that host's route points at the router (scripts/route-archive-hosts.mjs). Deploy order: the readers Worker
	// before the router.
	// docs/ARCHITECTURE-WORKERS.md has the runbook.
	// Names without "-env" suffix: an environment that sets `name` deploys as that Worker.
	"name": "flockstack-router",
	"main": "index.js",
	"compatibility_date": "2026-09-01",
	"workers_dev": true,
	"preview_urls": false,
	"observability": { "enabled": true },
	"account_id": "fe96ffccbfec88e9c8516169adb1fee2",
	"services": [
		{ "binding": "WEBSITE", "service": "flockstack-website" },
		{ "binding": "PUBLIC", "service": "flockstack-public" },
		{ "binding": "APP", "service": "flockstack" },
		{ "binding": "API", "service": "flockstack-api" },
		{ "binding": "READERS", "service": "flockstack-readers" }
	],
	"vars": {
		"FLOCKSTACK_REGION": "us",
		// The app's address: requests for any other host go straight to APP (workers.dev, tests). Set it to the router's own
		// workers.dev address to try the routing there.
		"APP_URL": "https://flockstack.io"
	},
	"env": {
		"us": {
			"name": "flockstack-router",
			"main": "index.js",
			"compatibility_date": "2026-09-01",
			"workers_dev": false,
			"preview_urls": false,
			"observability": { "enabled": true },
			"account_id": "fe96ffccbfec88e9c8516169adb1fee2",
			// www.flockstack.io has no DNS record of its own: a custom domain makes Cloudflare create the proxied record, and the router
			// answers it with a permanent redirect to flockstack.io (workers/router/routing.js, chooseRedirect).
			"routes": [
				{ "pattern": "flockstack.io", "custom_domain": true },
				{ "pattern": "www.flockstack.io", "custom_domain": true }
			],
			"services": [
				{ "binding": "WEBSITE", "service": "flockstack-website" },
				{ "binding": "PUBLIC", "service": "flockstack-public" },
				{ "binding": "APP", "service": "flockstack" },
				{ "binding": "API", "service": "flockstack-api" },
				{ "binding": "READERS", "service": "flockstack-readers" }
			],
			"vars": { "FLOCKSTACK_REGION": "us", "APP_URL": "https://flockstack.io" }
		},
		"eu-staged": {
			"name": "flockstack-router-eu",
			"main": "index.js",
			"compatibility_date": "2026-09-01",
			"workers_dev": true,
			"preview_urls": false,
			"observability": { "enabled": true },
			"account_id": "fe96ffccbfec88e9c8516169adb1fee2",
			"services": [
				{ "binding": "WEBSITE", "service": "flockstack-website" },
				{ "binding": "PUBLIC", "service": "flockstack-public-eu" },
				{ "binding": "APP", "service": "flockstack-eu" },
				{ "binding": "API", "service": "flockstack-api-eu" },
				{ "binding": "READERS", "service": "flockstack-readers-eu" }
			],
			"vars": { "FLOCKSTACK_REGION": "eu", "APP_URL": "https://eu.flockstack.io" }
		},
		"eu": {
			"name": "flockstack-router-eu",
			"main": "index.js",
			"compatibility_date": "2026-09-01",
			"workers_dev": false,
			"preview_urls": false,
			"observability": { "enabled": true },
			"account_id": "fe96ffccbfec88e9c8516169adb1fee2",
			"routes": [{ "pattern": "eu.flockstack.io", "custom_domain": true }],
			"services": [
				{ "binding": "WEBSITE", "service": "flockstack-website" },
				{ "binding": "PUBLIC", "service": "flockstack-public-eu" },
				{ "binding": "APP", "service": "flockstack-eu" },
				{ "binding": "API", "service": "flockstack-api-eu" },
				{ "binding": "READERS", "service": "flockstack-readers-eu" }
			],
			"vars": { "FLOCKSTACK_REGION": "eu", "APP_URL": "https://eu.flockstack.io" }
		}
	}
}

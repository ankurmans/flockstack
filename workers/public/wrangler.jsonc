{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	// FlockStack Cloud's public pages (docs/ARCHITECTURE-WORKERS.md). One Worker per region, like the app: each holds the files of the
	// build its own app Worker runs, so a region deployed alone never serves pages that point at the files of another build.
	// Build workers/public/dist first with `npm run build:public`; `npm run deploy:public` does that and deploys both regions.
	// POSTHOG_KEY (and POSTHOG_HOST, POSTHOG_SESSION_REPLAY when the app has them) are secrets of each Worker, set the same as the
	// app's: `npx wrangler secret put POSTHOG_KEY --config workers/public/wrangler.jsonc` (add `--env eu` for the EU Worker). Without
	// a key the pages carry no analytics.
	// The top level is the US Worker; the router reaches it through a service binding. workers.dev stays on while it is tested.
	"name": "flockstack-public",
	"main": "index.js",
	"compatibility_date": "2026-09-01",
	"workers_dev": true,
	"preview_urls": false,
	"observability": { "enabled": true },
	"account_id": "fe96ffccbfec88e9c8516169adb1fee2",
	"vars": { "FLOCKSTACK_REGION": "us" },
	"assets": {
		"directory": "./dist/assets/us",
		"binding": "ASSETS",
		// The script decides what is served and with which headers; the files are only read through the binding.
		"run_worker_first": true,
		"html_handling": "none",
		"not_found_handling": "none"
	},
	"env": {
		"eu": {
			"name": "flockstack-public-eu",
			"main": "index.js",
			"compatibility_date": "2026-09-01",
			"workers_dev": true,
			"preview_urls": false,
			"observability": { "enabled": true },
			"account_id": "fe96ffccbfec88e9c8516169adb1fee2",
			"vars": { "FLOCKSTACK_REGION": "eu" },
			"assets": {
				"directory": "./dist/assets/eu",
				"binding": "ASSETS",
				"run_worker_first": true,
				"html_handling": "none",
				"not_found_handling": "none"
			}
		}
	}
}

{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "flockstack",
	// worker-entry.mjs bundled by scripts/bundle-worker.mjs, which Wrangler runs first (build below). The OpenNext handler is
	// 40 MB: bundled by Wrangler itself it was 63 MB, took 130 MB of an isolate's 128, and the isolate was thrown away after
	// every request, so every page paid the cold start of the whole app. The script takes out the whitespace and nothing else.
	"main": ".worker/worker-entry.js",
	"no_bundle": true,
	"build": { "command": "node scripts/bundle-worker.mjs" },
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
	"workers_dev": true,
	// Hourly: PostShiba status, Telegram, expired exports, comment digests. Daily: Gmail spam rates (worker-entry.mjs).
	"triggers": { "crons": ["0 * * * *", "30 6 * * *"] },
	"preview_urls": false,
	"observability": { "enabled": true },
	"upload_source_maps": false,
	// The version's ID keys the cached public pages (lib/edge-cache.js), so a deploy never serves an old page from the cache.
	"version_metadata": { "binding": "CF_VERSION_METADATA" },
	// flockstack.io belongs to the router Worker (workers/router, docs/ARCHITECTURE-WORKERS.md) since the US cutover, so it is no
	// longer a route here. A newsletter's own domain, like newsletter.ankur.works, stays here for good: it never goes through the router.
	"routes": [{ "pattern": "newsletter.ankur.works", "custom_domain": true }],
	"account_id": "fe96ffccbfec88e9c8516169adb1fee2",
	"d1_databases": [{ "binding": "DB", "database_name": "flockstack", "database_id": "97615845-8aa2-413f-ad98-89821937069f", "migrations_dir": "migrations" }],
	"r2_buckets": [
		{ "binding": "IMAGES", "bucket_name": "flockstack-images" },
		{ "binding": "FILES", "bucket_name": "flockstack-files" },
		// Account exports wait here for their download (lib/export-storage.js). Private, with a lifecycle rule that deletes objects after 8 days.
		{ "binding": "EXPORTS", "bucket_name": "flockstack-exports" }
	],
	// Workers AI for the help chat's assistant, through AI Gateway's "default" gateway (README, Support assistant).
	// Without it the help chat doesn't render.
	"ai": { "binding": "AI" },
	// The marketing website, a separate Worker. The router Worker hands it its paths (lib/website-routing.js); this binding stays
	// for a domain that points straight at this Worker (the rollback) and for the router's fallback. Deploy the website first,
	// since a deploy that binds a Worker which does not exist fails. Without the binding those paths fall through to the app.
	"services": [{ "binding": "WEBSITE", "service": "flockstack-website" }],
	"vars": {
		"IMAGES_STORAGE": "r2",
		"FLOCKSTACK_CLOUD": "true",
		"FLOCKSTACK_REGION": "us"
	},
	// The EU deployment: the same code as a second Worker with its own EU-jurisdiction database and buckets
	// (README, Regions). Wrangler environments inherit no bindings, vars or routes, so everything it needs is here.
	// Deploy it with `npx wrangler deploy --env eu`, or everything with `node scripts/deploy-all.mjs`.
	"env": {
		"eu": {
			"name": "flockstack-eu",
			"main": ".worker/worker-entry.js",
			"no_bundle": true,
			"build": { "command": "node scripts/bundle-worker.mjs" },
			"compatibility_date": "2026-09-01",
			"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
			"assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
			// No workers.dev address: sessions, passkeys and links belong to eu.flockstack.io.
			"workers_dev": false,
			"preview_urls": false,
			"observability": { "enabled": true },
			"upload_source_maps": false,
			"version_metadata": { "binding": "CF_VERSION_METADATA" },
			// eu.flockstack.io belongs to the router Worker (flockstack-router-eu, workers/router) since the EU cutover.
			"triggers": { "crons": ["0 * * * *", "30 6 * * *"] },
			"account_id": "fe96ffccbfec88e9c8516169adb1fee2",
			"d1_databases": [{ "binding": "DB", "database_name": "flockstack-eu", "database_id": "3ffda07e-c73f-46ee-a933-1eb4feb18f70", "migrations_dir": "migrations" }],
			"r2_buckets": [
				{ "binding": "IMAGES", "bucket_name": "flockstack-images-eu", "jurisdiction": "eu" },
				{ "binding": "FILES", "bucket_name": "flockstack-files-eu", "jurisdiction": "eu" },
				{ "binding": "EXPORTS", "bucket_name": "flockstack-exports-eu", "jurisdiction": "eu" }
			],
			"ai": { "binding": "AI" },
			"services": [{ "binding": "WEBSITE", "service": "flockstack-website" }],
			"vars": {
				"IMAGES_STORAGE": "r2",
				"FLOCKSTACK_CLOUD": "true",
				"FLOCKSTACK_REGION": "eu",
				"SES_REGION": "eu-west-1"
			}
		}
	}
}

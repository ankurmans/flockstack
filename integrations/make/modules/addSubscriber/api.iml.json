{
  "url": "/contacts",
  "method": "POST",
  "body": {
    "email": "{{parameters.email}}",
    "source": "make",
    "newsletter": "{{ifempty(parameters.newsletter; undefined)}}",
    "tags": "{{ifempty(parameters.tags; undefined)}}",
    "fields": "{{ifempty(toCollection(parameters.fields; 'key'; 'value'); undefined)}}",
    "resubscribe": "{{if(parameters.resubscribe; true; undefined)}}"
  },
  "response": {
    "output": "{{body}}"
  }
}
